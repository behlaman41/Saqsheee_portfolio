{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "saqsheee-portfolio",
  "compatibility_date": "2026-08-04",
  "account_id": "d055538a5bbf0903662bfc5f1eb8f1c6",
  "workers_dev": true,
  // Pure static Astro output — no Worker script. Images must be baked at
  // `astro build` into /_astro/*; the /_image endpoint does not exist here.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Custom hostnames for the portfolio (Cloudflare zone saqsheee.com).
  "routes": [
    { "pattern": "saqsheee.com", "custom_domain": true },
    { "pattern": "www.saqsheee.com", "custom_domain": true }
  ]
}
