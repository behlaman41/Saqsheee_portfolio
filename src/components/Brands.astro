---
import { brands } from '../data/site'

/* The track scrolls to -50%, so the list is rendered twice; the second copy
   is decorative and hidden from assistive tech. */
const passes = [false, true]
---

<!-- ═══════════════ 04 · BRANDS ═══════════════ -->
<section class="block" id="brands">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="mono">{brands.head.eyebrow}</span>
      <span class="mono">{brands.head.num}</span>
    </div>
  </div>
  <div class="marquee reveal" aria-label={brands.marqueeLabel}>
    <div class="marquee-track">
      {
        passes.map((decorative) =>
          brands.names.map((name) => (
            <span class="marquee-item" aria-hidden={decorative ? 'true' : undefined}>
              {name}
            </span>
          ))
        )
      }
    </div>
  </div>
</section>
