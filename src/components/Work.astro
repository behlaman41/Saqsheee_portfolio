---
import { work, site } from '../data/site'

/* Second pass mirrors the first so the track can loop without a jump.
   Decorative copies are hidden from assistive tech. */
const passes = [false, true]
---

<!-- ═══════════════ 05 · WORK ═══════════════ -->
<section class="block wrap" id="work">
  <div class="sec-head reveal">
    <span class="mono">{work.head.eyebrow}</span>
    <span class="mono">{work.head.num}</span>
  </div>
  <h2 class="sec-title reveal">
    <span class="tmask"><span>{work.titleLead}<em>{work.titleAccent}</em></span></span>
  </h2>
  {/* Continuous marquee: three-ish tiles on desktop, a peek of the next on
      every breakpoint. motion.js eases the cruise so it never announces a
      start or an end. Posters stay in data-poster so they don't contend with
      the hero on first paint. */}
  <div
    class="work-carousel reveal"
    data-reel-carousel
    tabindex="0"
    aria-label={work.carouselLabel}
  >
    <div class="work-track">
      {
        passes.map((decorative) =>
          work.reels.map((reel) => (
            <a
              class="reel"
              href={reel.href}
              target="_blank"
              rel="noopener"
              draggable="false"
              aria-label={reel.label}
              aria-hidden={decorative ? 'true' : undefined}
              tabindex={decorative ? -1 : undefined}
            >
              <span class="idx">{reel.idx}</span><span class="cap">{work.tileCaption}</span>
              <video
                muted
                loop
                playsinline
                preload="none"
                data-poster={reel.poster}
                data-src={reel.src}
              />
              <span class="chip">↗</span>
            </a>
          ))
        )
      }
    </div>
  </div>
  <div class="work-foot reveal">
    <a class="link-mono" href={site.instagram} target="_blank" rel="noopener">
      {work.footLink}
    </a>
  </div>
</section>
