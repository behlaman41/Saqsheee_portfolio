---
import { meta, topbar, footer, site } from '../data/site'
import FooterMarquee from '../components/FooterMarquee.astro'

import '../styles/tokens.css'
import '../styles/fonts.css'
import '../styles/global.css'

/* Favicon is an inline SVG data-URI — no extra request, ported verbatim. */
const favicon =
  'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="%23FAF7F2"/><text x="32" y="45" font-family="Georgia,serif" font-style="italic" font-size="36" text-anchor="middle" fill="%23A85838">S</text></svg>'

/* Absolute when `site` is configured in astro.config.mjs (crawlers prefer it),
   otherwise the root-relative path. */
const ogImage = Astro.site
  ? new URL(meta.ogImage, Astro.site).href
  : meta.ogImage

/* Only the roman Fraunces is preloaded: the hero wordmark and every section
   title use it, so it is the one font on the critical paint path. The italic
   cut and both Plex families are discovered from the stylesheet a moment later.
   The hero photo is deliberately NOT preloaded — it is the first element in
   <body> with loading="eager" fetchpriority="high", so the preload scanner
   picks it up in the same chunk, whereas a <link rel="preload"> aimed at a
   <picture> needs a byte-exact imagesrcset or the browser fetches twice. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:type" content={meta.ogType} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content={meta.twitterCard} />
    <meta name="theme-color" content={meta.themeColor} />
    <link rel="icon" href={favicon} />
    <link rel="canonical" href={Astro.url.href} />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/fraunces-latin-opsz-normal.woff2"
      crossorigin
    />
  </head>
  <body>
    <div id="progress"></div>

    <!-- ═══════════════ TOPBAR ═══════════════ -->
    <header class="topbar">
      <a href="#top" class="mono">{topbar.home}</a>
      <span class="mono niche">{topbar.niche}</span>
      <a href="#contact" class="mono" style="color:var(--accent)">{topbar.cta}</a>
    </header>

    <main>
      <slot />
    </main>

    <!-- ═══════════════ FOOTER ═══════════════ -->
    <FooterMarquee />
    <footer class="footer">
      <span class="mono">{footer.copyright}</span>
      <span class="mono">{footer.tagline}</span>
    </footer>

    <script>
      import '../scripts/motion.js'
    </script>
  </body>
</html>
